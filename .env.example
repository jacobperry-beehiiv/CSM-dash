# ─── Data source ─────────────────────────────────────────────────────────
# Where to read the book of business from. One of:
#   snapshot  — read data/snapshot.json (refreshed by `npm run sync`). Default.
#   metabase  — live read from Metabase q10600 every page load (~60s cold).
DATA_SOURCE=snapshot

# Optional override for snapshot location.
SNAPSHOT_PATH=data/snapshot.enc.json

# Required when DATA_SOURCE=snapshot. 32-byte symmetric key for the
# AES-256-GCM-encrypted snapshot committed to the repo. Generate with:
#   openssl rand -base64 32
# Set this value identically in:
#   • .env.local                                (local dev)
#   • Vercel project env                        (runtime decrypt)
#   • GitHub Actions repo secret                (scheduled sync encrypt)
SNAPSHOT_ENCRYPTION_KEY=

# ─── Persistence ─────────────────────────────────────────────────────────
# When DATABASE_URL is set, settings/templates/tiers/Gmail tokens/flag
# resolutions/customer overrides all live in a single Postgres `csm_kv`
# table. Without it, those land in JSON files under data/ — fine for local
# dev, BUT NOT a serverless deploy. Provision a free Neon/Supabase/Vercel
# Postgres and paste the connection string here for any hosted deploy.
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# ─── Metabase (required when DATA_SOURCE=metabase) ──────────────────────
METABASE_URL=https://beehiiv.metabaseapp.com

# Preferred: API key. Admin-only to create (Admin → Authentication → API Keys).
METABASE_API_KEY=

# Fallback: copy `metabase.SESSION` cookie value from your logged-in browser.
# Expires every ~14 days, refresh when it 401s.
METABASE_SESSION_TOKEN=

# Last resort (legacy): doesn't work for SSO-only accounts.
METABASE_USERNAME=
METABASE_PASSWORD=

# ─── External link templates ────────────────────────────────────────────
# Where the per-row "Masquerade" button takes you. {email} is substituted
# with the customer's owner email (the lookup key in beehiiv's admin tool).
NEXT_PUBLIC_MASQUERADE_URL_TEMPLATE=https://app.beehiiv.com/system_admin/users/masquerade?email={email}

# Metabase deep-link template for the deliverability per-row "Open Metabase"
# button. Tokens: {workspace_id}, {workspace_name}, {publication_id}.
NEXT_PUBLIC_METABASE_PUB_URL_TEMPLATE=https://beehiiv.metabaseapp.com/question/3401-all-with-filters?company_%252F_workspace_search={workspace_name}

# ─── Gmail (for bulk-draft creation directly in your Drafts folder) ─────
# Create an OAuth 2.0 Client ID in Google Cloud Console → Credentials
# (Web application). Add the deployed callback to Authorized redirect URIs:
#   http://localhost:3000/api/auth/google/callback           (local dev)
#   https://<your-vercel-domain>/api/auth/google/callback    (prod)
# On the consent screen, add the `gmail.compose` scope.
# Each CSM connects their own Gmail at /settings/gmail.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override (defaults to the dashboard origin + /api/auth/google/callback).
# GOOGLE_OAUTH_REDIRECT_URI=

# ─── NextAuth — dashboard sign-in (Google SSO, @beehiiv.com only) ──────
# Required: a random 32+ byte string. Generate with: openssl rand -base64 33
AUTH_SECRET=
# Sign-in reuses GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET from above. The
# same Google OAuth client just needs BOTH redirect URIs registered:
#   /api/auth/google/callback     ← Gmail draft connection (gmail.compose)
#   /api/auth/callback/google     ← NextAuth sign-in (openid/email/profile)
# Set AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET if you ever want a separate
# sign-in OAuth client; otherwise leave them blank.

# ─── Optional integrations ──────────────────────────────────────────────
# Slack bot token for posting alerts.
SLACK_BOT_TOKEN=
SLACK_DELIVERABILITY_CHANNEL=

# Slack channel ID for the "feature updates" feed surfaced on the home
# page. The bot must be invited to this channel and the token above must
# carry `channels:history` (or `groups:history` for private channels) and
# `users:read` scopes. Channel ID, NOT name — e.g. C093C6MDS1E.
SLACK_FEATURE_UPDATES_CHANNEL_ID=

# Shared secret used by Vercel Cron to call /api/feature-updates/sync.
# Generate with: openssl rand -hex 32 . Set the same value in Vercel
# project env vars; Vercel injects it into the cron's Authorization
# header automatically.
CRON_SECRET=

# HubSpot auth for the sync-time "last activity" enrichment in
# scripts/sync.ts. Captures activity rollup across ALL contacts at a
# company (emails / calls / meetings / notes) instead of the narrow
# notes_last_contacted property. Drives the "Last contacted" column,
# Flag H, and the `{{customer.last_contacted}}` merge tag.
#
# Two credential paths — set ONE of:
#
#   A) Private App access token (simplest, never expires).
#      Create via Settings → Integrations → Private Apps → "Create".
#      Copy the `pat-na1-…` from the Auth tab.
#   B) OAuth client_credentials grant (when provisioned as a HubSpot
#      OAuth app instead of a Private App). The integration mints a
#      short-lived bearer token in-process.
#
# Required scopes (both paths):
#   - crm.objects.companies.read
#   - crm.schemas.companies.read
#   - crm.objects.contacts.read
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# Bearer token for external integrations posting to /api/customer-signals
# (the csm-dash-signal Claude skill, automated jobs, etc.). When set, any
# request carrying `Authorization: Bearer <key>` is allowed to read/write
# customer-signal records without a NextAuth session. Generate with:
#   openssl rand -base64 33
# Treat as a secret. Rotate by changing the value + redeploying.
SIGNAL_API_KEY=
